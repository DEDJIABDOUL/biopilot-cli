{
  "name": "biopilot-cli",
  "version": "1.1.4",
  "description": "Terminal autocompletion for bioinformatics tools",
  "type": "module",
  "engines": {
    "node": ">=22.0 <23.0.0"
  },
  "bin": {
    "biopilot": "./build/index.js"
  },
  "files": [
    "build/**",
    "shell/**",
    "scripts/**",
    "*.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "build:db": "tsx ./scripts/build-db.ts",
    "package": "tsx ./scripts/pkg.ts",
    "package:base": "tsx ./scripts/pkg-base.ts",
    "dev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import=tsx src/index.ts -V",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:e2e": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.e2e.config.cjs",
    "lint": "eslint src/ --ext .ts,.tsx && prettier src/ --check",
    "lint:fix": "eslint src/ --ext .ts,.tsx --fix && prettier src/ --write",
    "perf": "npm run build && tsx ./scripts/perf/run.ts",
    "perf:session": "npm run build && tsx ./scripts/perf/session.ts",
    "perf:catalog": "tsx ./scripts/perf/catalog.ts",
    "perf:targets": "tsx ./scripts/perf/targets.ts",
    "perf:profile": "npm run build && node --cpu-prof --heap-prof --import=tsx ./scripts/perf/run.ts",
    "debug": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --inspect --import=tsx src/index.ts -V"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DEDJIABDOUL/biopilot-cli.git"
  },
  "author": {
    "name": "BioPilot CLI contributors"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/DEDJIABDOUL/biopilot-cli/issues"
  },
  "homepage": "https://github.com/DEDJIABDOUL/biopilot-cli#readme",
  "dependencies": {
    "@withfig/autocomplete": "2.692.3",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/headless": "^6.0.0",
    "ajv": "^8.20.0",
    "ansi-escapes": "^7.3.0",
    "ansi-styles": "^7.0.0",
    "better-sqlite3": "13.0.3",
    "chalk": "^6.0.1",
    "color-convert": "^3.1.3",
    "commander": "^15.0.0",
    "find-process": "^1.4.11",
    "node-pty": "1.2.0-beta.18",
    "strip-ansi": "^7.2.0",
    "toml": "^5.0.1",
    "uuid": "^14.0.3",
    "which": "^7.0.0",
    "wrap-ansi": "^10.0.2"
  },
  "devDependencies": {
    "@microsoft/tui-test": "^0.1.1",
    "@tsconfig/node18": "^18.2.7",
    "@types/better-sqlite3": "9.6.0",
    "@types/color-convert": "^3.0.1",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/wcwidth": "^1.0.2",
    "@types/which": "^3.0.4",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@withfig/autocomplete-types": "^1.31.0",
    "@xterm/xterm": "^6.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.51.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-header": "^3.1.1",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "jest": "^30.5.2",
    "lint-staged": "^17.6.0",
    "prettier": "3.9.10",
    "ts-jest": "^29.4.15",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "yaml": "2.9.1"
  },
  "lint-staged": {
    "{,src/**/}*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "overrides": {
    "js-yaml@4": "4.3.2",
    "js-yaml@3": "3.15.2",
    "brace-expansion@1": "1.1.21"
  }
}
