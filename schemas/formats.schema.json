{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/DEDJIABDOUL/biopilot-cli/schemas/formats.schema.json",
  "title": "BioPilot Catalog: file formats",
  "description": "Format of knowledge/formats.yml: every file format the tools refer to, declared once.",
  "type": "object",
  "additionalProperties": false,
  "required": ["formats"],
  "properties": {
    "formats": {
      "type": "array",
      "items": { "$ref": "#/definitions/format" }
    }
  },
  "definitions": {
    "format": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Name the tools use in `value.format`, e.g. fastq, bwa-index." },
        "description": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["file", "prefix", "dir"],
          "default": "file",
          "description": "file: one file, recognised by its name. prefix: a reference index named by a common prefix plus required suffixes (bwa). dir: a reference index held in a folder containing a marker file (salmon)."
        },
        "pattern": {
          "type": "string",
          "minLength": 1,
          "description": "kind file: JavaScript regular expression matched against the file name, case-insensitively, e.g. '\\.(fastq|fq)(\\.gz)?$'."
        },
        "suffixes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 },
          "description": "kind prefix: suffixes that must all exist after the prefix, e.g. [\".bwt\", \".sa\"]."
        },
        "marker": { "type": "string", "minLength": 1, "description": "kind dir: file that must exist inside the folder, e.g. versionInfo.json." }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "enum": ["prefix"] } }, "required": ["kind"] },
          "then": { "required": ["suffixes"], "not": { "anyOf": [{ "required": ["pattern"] }, { "required": ["marker"] }] } }
        },
        {
          "if": { "properties": { "kind": { "enum": ["dir"] } }, "required": ["kind"] },
          "then": { "required": ["marker"], "not": { "anyOf": [{ "required": ["pattern"] }, { "required": ["suffixes"] }] } }
        },
        {
          "if": { "not": { "required": ["kind"] } },
          "then": { "required": ["pattern"], "not": { "anyOf": [{ "required": ["suffixes"] }, { "required": ["marker"] }] } }
        },
        {
          "if": { "properties": { "kind": { "enum": ["file"] } }, "required": ["kind"] },
          "then": { "required": ["pattern"], "not": { "anyOf": [{ "required": ["suffixes"] }, { "required": ["marker"] }] } }
        }
      ]
    }
  }
}
