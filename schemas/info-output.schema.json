{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/DEDJIABDOUL/biopilot-cli/schemas/info-output.schema.json",
  "title": "biopilot info --json output, format 1",
  "description": "Contract of `biopilot info --json`. Adding a field does not change `format`; removing or renaming one increments it. Errors are reported on stderr with exit code 1 and nothing on stdout. `command.subcommands` and `command.arguments` were added in format 1 (ticket #6). Value details, version ranges, option forms, mates and derived outputs were added in format 1 (ticket #7). `option.rules` was added in format 1 (ticket #8). `value.formats` and argument `mate` were added in format 1 (ticket #25).",
  "type": "object",
  "required": ["format"],
  "properties": {
    "format": {
      "const": 1
    }
  },
  "oneOf": [
    {
      "title": "Tool list (`biopilot info --json`)",
      "required": ["tools"],
      "properties": {
        "tools": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/tool"
          }
        }
      }
    },
    {
      "title": "One command and its options (`biopilot info --json <tool> [command…]`)",
      "required": ["tool", "command", "options"],
      "properties": {
        "tool": {
          "$ref": "#/$defs/tool"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/option"
          },
          "description": "Highest rank first, ties in Catalog order."
        }
      }
    },
    {
      "title": "One option (`biopilot info --json <tool> [command…] <option>`)",
      "required": ["tool", "command", "option"],
      "properties": {
        "tool": {
          "$ref": "#/$defs/tool"
        },
        "command": {
          "$ref": "#/$defs/command"
        },
        "option": {
          "$ref": "#/$defs/option"
        }
      }
    }
  ],
  "$defs": {
    "tool": {
      "type": "object",
      "required": ["name", "package", "description", "platforms"],
      "properties": {
        "name": {
          "type": "string",
          "description": "Executable name."
        },
        "package": {
          "type": ["string", "null"],
          "description": "Conda package, when it differs from the name."
        },
        "description": {
          "type": ["string", "null"]
        },
        "platforms": {
          "type": "array",
          "items": {
            "enum": ["illumina", "nanopore"]
          },
          "description": "Sequencing platforms the tool serves; empty means generic."
        }
      }
    },
    "command": {
      "type": "object",
      "required": ["path", "description", "subcommands", "arguments"],
      "properties": {
        "path": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Subcommand path from the tool; empty for the root command."
        },
        "description": {
          "type": ["string", "null"]
        },
        "subcommands": {
          "type": "array",
          "description": "Direct subcommands, in Catalog order.",
          "items": {
            "type": "object",
            "required": ["name", "description"],
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": ["string", "null"]
              }
            }
          }
        },
        "arguments": {
          "type": "array",
          "description": "Positional arguments, in order.",
          "items": {
            "type": "object",
            "required": ["name", "description", "variadic", "value", "default", "since", "until", "mate"],
            "properties": {
              "name": {
                "type": "string"
              },
              "description": {
                "type": ["string", "null"]
              },
              "variadic": {
                "type": "boolean",
                "description": "Takes one or more values."
              },
              "value": {
                "$ref": "#/$defs/value"
              },
              "default": {
                "type": ["string", "null"]
              },
              "since": {
                "type": ["string", "null"]
              },
              "until": {
                "type": ["string", "null"]
              },
              "mate": {
                "type": ["string", "null"],
                "description": "Name of the read-pair mate argument, in either direction."
              }
            }
          }
        }
      }
    },
    "option": {
      "type": "object",
      "required": [
        "canonical_name",
        "aliases",
        "description",
        "value",
        "default",
        "rank",
        "since",
        "until",
        "repeatable",
        "hidden",
        "deprecated",
        "mate",
        "derive",
        "rules"
      ],
      "properties": {
        "canonical_name": {
          "type": "string",
          "description": "First long name, otherwise first name."
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Every name of the option, canonical name included. Case-sensitive."
        },
        "description": {
          "type": ["string", "null"]
        },
        "value": {
          "$ref": "#/$defs/value"
        },
        "default": {
          "type": ["string", "null"]
        },
        "rank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100
        },
        "since": {
          "type": ["string", "null"],
          "description": "First tool version that has the option, when known."
        },
        "until": {
          "type": ["string", "null"],
          "description": "Last tool version that has the option, when known."
        },
        "repeatable": {
          "type": "boolean"
        },
        "hidden": {
          "type": "boolean",
          "description": "Known but never suggested."
        },
        "deprecated": {
          "type": "boolean"
        },
        "mate": {
          "type": ["string", "null"],
          "description": "Canonical name of the read-pair mate, in either direction."
        },
        "derive": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "required": ["from", "suffix"],
              "properties": {
                "from": {
                  "type": "string",
                  "description": "Canonical name of the source option."
                },
                "suffix": {
                  "type": "string"
                }
              }
            }
          ]
        },
        "rules": {
          "type": "array",
          "description": "Context rules, in Catalog order: `boost` is added to `rank` when `when` holds.",
          "items": {
            "type": "object",
            "required": ["when", "boost"],
            "properties": {
              "when": {
                "type": "object",
                "required": ["used", "paired", "platform", "assay"],
                "properties": {
                  "used": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "description": "Canonical names of options that must already be on the command line."
                  },
                  "paired": {
                    "type": ["boolean", "null"]
                  },
                  "platform": {
                    "enum": ["illumina", "nanopore", null],
                    "description": "Holds when the project's platforms contain it."
                  },
                  "assay": {
                    "enum": ["rna-seq", "variant-calling", "unknown", null]
                  }
                }
              },
              "boost": {
                "type": "integer",
                "minimum": -100,
                "maximum": 100
              }
            }
          }
        }
      }
    },
    "value": {
      "oneOf": [
        {
          "type": "null",
          "description": "A flag: takes no value."
        },
        {
          "type": "object",
          "required": ["type", "format", "optional", "multiple", "values", "read_role", "formats"],
          "properties": {
            "type": {
              "enum": ["int", "float", "string", "file", "dir", "enum"]
            },
            "format": {
              "type": ["string", "null"],
              "description": "First accepted format (kept for format-1 consumers); see `formats`."
            },
            "optional": {
              "type": "boolean",
              "description": "The value may be omitted (--opt[=VAL])."
            },
            "multiple": {
              "type": "boolean",
              "description": "Several values follow the option."
            },
            "values": {
              "type": "array",
              "description": "Suggested values; the only allowed ones when type is enum.",
              "items": {
                "type": "object",
                "required": ["value", "description"],
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "description": {
                    "type": ["string", "null"]
                  }
                }
              }
            },
            "read_role": {
              "enum": [1, 2, null],
              "description": "Read 1 or read 2 of a read pair."
            },
            "formats": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Every accepted format, most common first."
            }
          }
        }
      ]
    }
  }
}
