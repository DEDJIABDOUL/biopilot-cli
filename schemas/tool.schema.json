{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/DEDJIABDOUL/biopilot-cli/schemas/tool.schema.json",
  "title": "BioPilot Catalog: one tool",
  "description": "Format of knowledge/tools/<tool>.yml. `npm run build:db` validates every file against this schema, then runs the cross-file checks (duplicate tools, duplicate aliases, version regex).",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "version"],
  "properties": {
    "name": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\s/]+$",
      "description": "Executable name, as typed in the shell (e.g. fastp, porechop, blastn)."
    },
    "package": {
      "type": "string",
      "minLength": 1,
      "description": "Conda package, when it differs from the executable name."
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Short description, in our own words (never copied from --help)."
    },
    "platforms": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": ["illumina", "nanopore"]
      },
      "description": "Sequencing platforms the tool serves; omit or leave empty for a generic tool."
    },
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["args", "regex"],
      "properties": {
        "args": {
          "$ref": "#/definitions/args",
          "description": "Arguments that make the tool print its version, e.g. [\"--version\"]."
        },
        "regex": {
          "type": "string",
          "minLength": 1,
          "description": "JavaScript regular expression with exactly one capture group: the version number."
        }
      }
    },
    "help": {
      "$ref": "#/definitions/args",
      "description": "Arguments that make the tool print its help, e.g. [\"--help\"]."
    },
    "options": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/option"
      },
      "description": "Options of the root command."
    },
    "arguments": {
      "$ref": "#/definitions/arguments",
      "description": "Positional arguments of the root command."
    },
    "commands": {
      "$ref": "#/definitions/commands"
    }
  },
  "definitions": {
    "args": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "required": ["names"],
      "properties": {
        "names": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^--?[^\\s-]\\S*$"
          },
          "description": "Every alias of the option (case-sensitive). The first long name is the canonical name."
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "$ref": "#/definitions/optionValue"
        },
        "default": {
          "type": ["string", "number", "boolean"]
        },
        "rank": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100,
          "default": 50,
          "description": "90–100 main inputs/outputs and reference; 70–89 very common; 50 default; 30–49 fine tuning; 10–29 rare, debug or deprecated."
        },
        "rules": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/rule"
          }
        },
        "since": {
          "type": "string",
          "minLength": 1,
          "description": "First tool version that has the option, when known."
        },
        "until": {
          "type": "string",
          "minLength": 1,
          "description": "Last tool version that has the option, when known."
        },
        "repeatable": {
          "type": "boolean",
          "default": false,
          "description": "May be given several times."
        },
        "hidden": {
          "type": "boolean",
          "default": false,
          "description": "Known (for parsing a command line) but never suggested."
        },
        "deprecated": {
          "type": "boolean",
          "default": false,
          "description": "Still accepted but obsolete; give it a low rank."
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["when", "boost"],
      "properties": {
        "when": {
          "type": "object",
          "description": "Context condition (stored from ticket #8 on)."
        },
        "boost": {
          "type": "integer",
          "minimum": -100,
          "maximum": 100,
          "description": "Added to the rank when the condition holds."
        }
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/command"
      },
      "description": "Subcommands, in the order the tool lists them."
    },
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[^\\s-]\\S*$",
          "description": "Subcommand name as typed after its parent (e.g. sort for `samtools sort`)."
        },
        "help": {
          "$ref": "#/definitions/args",
          "description": "Arguments that make the tool print this subcommand's help, e.g. [\"sort\", \"--help\"]."
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "options": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/option"
          }
        },
        "arguments": {
          "$ref": "#/definitions/arguments"
        },
        "commands": {
          "$ref": "#/definitions/commands"
        }
      }
    },
    "arguments": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/argument"
      },
      "description": "Positional arguments, in order."
    },
    "argument": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "description": "Placeholder name, e.g. in.bam."
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "variadic": {
          "type": "boolean",
          "default": false,
          "description": "Takes one or more values; only the last argument may be variadic."
        },
        "value": {
          "$ref": "#/definitions/argumentValue"
        },
        "default": {
          "type": ["string", "number", "boolean"]
        },
        "since": {
          "type": "string",
          "minLength": 1,
          "description": "First tool version that has the option, when known."
        },
        "until": {
          "type": "string",
          "minLength": 1,
          "description": "Last tool version that has the option, when known."
        }
      }
    },
    "argumentValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["int", "float", "string", "file", "dir", "enum"],
          "description": "int, float, string, file, dir or enum. Only enum restricts the value to `values`."
        },
        "format": {
          "type": "string",
          "description": "type file or dir: a format declared in knowledge/formats.yml (fastq, bam, bwa-index…)."
        },
        "optional": {
          "type": "boolean",
          "default": false,
          "description": "The value may be omitted: --opt[=VAL]."
        },
        "multiple": {
          "type": "boolean",
          "default": false,
          "description": "Takes several values after the option."
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["value"],
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          },
          "description": "Suggested values; for type enum, the only allowed ones."
        },
        "read_role": {
          "enum": [1, 2],
          "description": "type file: read 1 or read 2 of a read pair."
        }
      },
      "description": "What the argument takes."
    },
    "optionValue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["int", "float", "string", "file", "dir", "enum"],
          "description": "int, float, string, file, dir or enum. Only enum restricts the value to `values`."
        },
        "format": {
          "type": "string",
          "description": "type file or dir: a format declared in knowledge/formats.yml (fastq, bam, bwa-index…)."
        },
        "optional": {
          "type": "boolean",
          "default": false,
          "description": "The value may be omitted: --opt[=VAL]."
        },
        "multiple": {
          "type": "boolean",
          "default": false,
          "description": "Takes several values after the option."
        },
        "values": {
          "type": "array",
          "minItems": 1,
          "items": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["value"],
                "properties": {
                  "value": {
                    "type": "string"
                  },
                  "description": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          },
          "description": "Suggested values; for type enum, the only allowed ones."
        },
        "read_role": {
          "enum": [1, 2],
          "description": "type file: read 1 or read 2 of a read pair."
        },
        "mate_of": {
          "type": "string",
          "description": "Alias of the mate option (same command), which has the other read role."
        },
        "derive": {
          "type": "object",
          "additionalProperties": false,
          "required": ["from", "suffix"],
          "properties": {
            "from": {
              "type": "string",
              "description": "Alias of the option whose value this output is derived from."
            },
            "suffix": {
              "type": "string",
              "minLength": 1,
              "description": "Added before the extensions, e.g. .trimmed → ctrl_R1.trimmed.fastq.gz."
            }
          },
          "description": "type file: output name derived from another option's value."
        }
      },
      "description": "What the option takes. Omit for a flag."
    }
  }
}
